---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
{#- Nunjucks autoescaping is on, so every interpolation below is XML-escaped for
    free. That is why the post bodies are not wrapped in CDATA: escaped markup in
    <content:encoded> is equally valid and cannot be broken by a stray "]]>". -#}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ profile.name }}</title>
    <link>{{ "/" | absoluteUrl(site.url) }}</link>
    <description>{{ site.description }}</description>
    <language>{{ site.lang }}</language>
    <atom:link href="{{ "/feed.xml" | absoluteUrl(site.url) }}" rel="self" type="application/rss+xml"/>
    {%- set posts = collections.writing | reverse | limit(20) %}
    {%- if posts.length %}
    <lastBuildDate>{{ posts[0].date | rfc822Date }}</lastBuildDate>
    {%- endif %}
    {%- for post in posts %}
    <item>
      <title>{{ post.data.title }}</title>
      <link>{{ post.url | absoluteUrl(site.url) }}</link>
      {#- The URL is stable and unique, so it doubles as the identity readers
          deduplicate on. #}
      <guid isPermaLink="true">{{ post.url | absoluteUrl(site.url) }}</guid>
      <pubDate>{{ post.date | rfc822Date }}</pubDate>
      {%- if post.data.excerpt %}
      <description>{{ post.data.excerpt }}</description>
      {%- endif %}
      <content:encoded>{{ post.templateContent | absoluteHtml(site.url) }}</content:encoded>
    </item>
    {%- endfor %}
  </channel>
</rss>
